/// Subject: Holo Hosting proof-of-service — one agreement settles host payment for
/// BOTH Holo services, EdgeNode and WindTunnel. The execution logic is identical;
/// only the invoice payload differs (an EdgeNode invoice fills storage/gossip/gets,
/// a WindTunnel invoice fills its two placeholders).
///
/// Users:
/// - EdgeNode Customer (spender + executor): funds the agreement with base-unit
///   credit, fixes the price sheet at creation, and executes.
/// - Log Harvester (invoicing gateway): parks the host work-proofs.
/// - EdgeNode Hosts (receivers): paid per the metered work in their logs.
///
/// Inputs:
/// - edge_node_customer_spender_allocations: base-unit credit the customer parked
///   to fund host payment (auto-generated by the pre-processor).
/// - invoice_payloads: per-host work-proofs; each carries host_pub_key and logs
///   (the metered counts s/g/gt/wt1/wt2).
/// - price_sheet_data_blob_hash (Fixed): the price sheet — per-dimension base
///   rates (base_per_st/gsp/get/wt1/wt2).
///
/// Summary:
/// Prices each host's logged work against the Fixed price sheet and settles it from
/// the customer's base-unit credit. The metered dimensions are pinned to FIXED unit
/// indices — the lane's service units and the price-sheet rate keys line up:
///   "0" base payment (HoloFuel — the network's base fuel unit) · "2" storage
///   · "3" gossip · "4" gets · "5" wt1 · "6" wt2 (the WindTunnel placeholders)
/// Index "1" is a lane-specific unit (HOT on the live Holo Hosting lane) that this
/// agreement does not touch. Every dimension is independent and optional: a log
/// count or price-sheet rate that is absent counts as 0, so one code path settles
/// an EdgeNode invoice, a WindTunnel invoice, or any partial mix without a missing
/// key breaking it.

let BASE = "0"; // base fuel unit (HoloFuel) that funds host payment

// Per dimension: the executor unit index it credits, the price-sheet rate key,
// and the invoice log-count key.
let dims = [
    #{ unit: "2", rate: "base_per_st",  count: "s"   },
    #{ unit: "3", rate: "base_per_gsp", count: "g"   },
    #{ unit: "4", rate: "base_per_get", count: "gt"  },
    #{ unit: "5", rate: "base_per_wt1", count: "wt1" },
    #{ unit: "6", rate: "base_per_wt2", count: "wt2" },
];

let price_sheet = get_data_blob(inputs.price_sheet_data_blob_hash.data);
let customer_alloc = consumed_inputs.edge_node_customer_spender_allocations;

let final_unyt_allocation = [];
let total_payment_expected = 0.0;
// Service-unit totals per dimension, accumulated across all invoices and credited
// to the executor on each dimension's own unit index.
let dimension_totals = #{ "2": 0.0, "3": 0.0, "4": 0.0, "5": 0.0, "6": 0.0 };
let able_to_pay = true;

// Resolve each dimension's rate once up front — the price sheet is Fixed for the
// whole execution, so this keeps the per-invoice loop from re-reading it when many
// invoices aggregate into a single settlement.
let rates = #{};
for dim in dims {
    rates[dim.unit] = price_sheet[dim.rate] ?? 0;
}

for (value, vi) in consumed_inputs.invoice_payloads {
    for (payload, pi) in value.data {
        // Sum this host's logged counts per dimension (absent count => 0).
        let host_counts = #{ "2": 0.0, "3": 0.0, "4": 0.0, "5": 0.0, "6": 0.0 };
        for (log, li) in payload.logs {
            for dim in dims {
                // absent count => "0" (indexing a missing object-map key yields ())
                host_counts[dim.unit] = host_counts[dim.unit] + parse_float(log[dim.count] ?? "0");
            }
        }

        // Price the host: expected = Σ count_d × rate_d (rates resolved once above).
        let exp_amt = 0.0;
        for dim in dims {
            exp_amt = exp_amt + host_counts[dim.unit] * rates[dim.unit];
            dimension_totals[dim.unit] = dimension_totals[dim.unit] + host_counts[dim.unit];
        }

        total_payment_expected = total_payment_expected + exp_amt;

        if able_to_pay {
            // Find a customer allocation whose base-unit amount covers this invoice.
            let customer_index =
                customer_alloc.index_of(|a| parse_float(a.data.amount[BASE] ?? "0") >= exp_amt);
            if customer_index >= 0 {
                let customer_amount_used = customer_alloc[customer_index];
                // Build with an indexed assignment: `#{ BASE: x }` would use the
                // literal key "BASE", not the value of BASE.
                let invoice_amount = #{};
                invoice_amount[BASE] = exp_amt.to_string();
                final_unyt_allocation.push(#{
                    "receiver": payload.host_pub_key,
                    "amounts": invoice_amount,
                    "sources": [customer_amount_used.data.source]
                });
                // Subtract the spent amount from that source, in place.
                let remaining_amount = sub_units(customer_amount_used.data.amount, invoice_amount);
                customer_alloc[customer_index].data.amount = remaining_amount;
            } else {
                // Can't cover this invoice — keep tallying the total so the error
                // reports the full outstanding amount, then stop allocating.
                able_to_pay = false;
            }
        }
    }
}

if able_to_pay {
    // Credit each metered dimension's total to the executor on its own unit index.
    let executor_amounts = #{};
    let has_dimension_totals = false;
    for dim in dims {
        if dimension_totals[dim.unit] > 0.0 {
            executor_amounts[dim.unit] = dimension_totals[dim.unit].to_string();
            has_dimension_totals = true;
        }
    }
    if has_dimension_totals {
        final_unyt_allocation.push(#{
            "receiver": executor_pub_key,
            "amounts": executor_amounts,
            "sources": consumed_inputs.invoice_payloads.map(|p| p.link_hash)
        });
    }

    // Return the executor's unspent base-unit funding (carry-forward is future work).
    let remaining_customer_alloc = 0.0;
    let remaining_sources = [];
    for (alloc, i) in customer_alloc {
        let amt = parse_float(alloc.data.amount[BASE] ?? "0");
        if amt > 0.0 {
            remaining_customer_alloc = remaining_customer_alloc + amt;
            remaining_sources.push(alloc.data.source);
        }
    }
    if remaining_customer_alloc > 0.0 {
        let remainder_amount = #{};
        remainder_amount[BASE] = remaining_customer_alloc.to_string();
        final_unyt_allocation.push(#{
            "receiver": executor_pub_key,
            "amounts": remainder_amount,
            "sources": remaining_sources
        });
    }

    return #{
        "output": #{
            "unyt_allocation": final_unyt_allocation
        }
    };
} else {
    throw "For execution to succeed, a payment of " + total_payment_expected.to_string() + " ZF must be sent to this agreement to settle outstanding invoices.";
}
