{
  "type": "object",
  "properties": {
    "consumed_inputs": {
      "type": "object",
      "properties": {
        "log_harvester_spender_allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "object", "additionalProperties": { "type": "string" } },
              "source": { "type": "string" }
            },
            "required": ["amount", "source"]
          }
        },
        "edge_node_customer_spender_allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "object", "additionalProperties": { "type": "string" } },
              "source": { "type": "string" }
            },
            "required": ["amount", "source"]
          }
        },
        "invoice_payloads": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host_pub_key": { "type": "string" },
                "logs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "s": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
                      "g": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
                      "gt": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
                      "wt1": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
                      "wt2": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
                    }
                  }
                }
              },
              "required": ["host_pub_key", "logs"]
            }
          }
        }
      },
      "required": ["log_harvester_spender_allocations", "edge_node_customer_spender_allocations", "invoice_payloads"]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "price_sheet_data_blob_hash": { "type": "string" }
      },
      "required": ["price_sheet_data_blob_hash"]
    }
  },
  "required": ["consumed_inputs", "inputs"]
}
